<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EFP.Desktop.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Page" Color="#F5F6FA"/>
                    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="Ink" Color="#151827"/>
                    <SolidColorBrush x:Key="Muted" Color="#5D6377"/>
                    <SolidColorBrush x:Key="CardLine" Color="#E4E6EF"/>
                    <SolidColorBrush x:Key="Accent" Color="#5B5EF0"/>
                    <SolidColorBrush x:Key="RingTrack" Color="#ECEEF5"/>
                    <SolidColorBrush x:Key="IconBg" Color="#F2F1FE"/>
                    <SolidColorBrush x:Key="PillBg" Color="#EFEEFE"/>
                    <SolidColorBrush x:Key="HoverLine" Color="#C7C5FB"/>
                    <SolidColorBrush x:Key="Faint" Color="#C3C7D4"/>
                    <SolidColorBrush x:Key="OkBg" Color="#E3F6EE"/>
                    <SolidColorBrush x:Key="OkText" Color="#0B6B4A"/>
                    <SolidColorBrush x:Key="OkStrong" Color="#10A36B"/>
                    <SolidColorBrush x:Key="WarnBg" Color="#FFF3DC"/>
                    <SolidColorBrush x:Key="WarnText" Color="#8A5300"/>
                    <SolidColorBrush x:Key="WarnStrong" Color="#E89A10"/>
                    <SolidColorBrush x:Key="FailBg" Color="#FDECEC"/>
                    <SolidColorBrush x:Key="FailText" Color="#9B1C1C"/>
                    <SolidColorBrush x:Key="FailStrong" Color="#DC3B3B"/>
                    <SolidColorBrush x:Key="Overlay" Color="#990A1020"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Page" Color="#0F1117"/>
                    <SolidColorBrush x:Key="Surface" Color="#181B24"/>
                    <SolidColorBrush x:Key="Ink" Color="#ECEEF5"/>
                    <SolidColorBrush x:Key="Muted" Color="#9AA0B4"/>
                    <SolidColorBrush x:Key="CardLine" Color="#2A2F3C"/>
                    <SolidColorBrush x:Key="Accent" Color="#9496FF"/>
                    <SolidColorBrush x:Key="RingTrack" Color="#2A2F3C"/>
                    <SolidColorBrush x:Key="IconBg" Color="#232640"/>
                    <SolidColorBrush x:Key="PillBg" Color="#262A47"/>
                    <SolidColorBrush x:Key="HoverLine" Color="#4B4F86"/>
                    <SolidColorBrush x:Key="Faint" Color="#3A3F4E"/>
                    <SolidColorBrush x:Key="OkBg" Color="#12352A"/>
                    <SolidColorBrush x:Key="OkText" Color="#6EE7B7"/>
                    <SolidColorBrush x:Key="OkStrong" Color="#22C58A"/>
                    <SolidColorBrush x:Key="WarnBg" Color="#3A2E12"/>
                    <SolidColorBrush x:Key="WarnText" Color="#FCD34D"/>
                    <SolidColorBrush x:Key="WarnStrong" Color="#F5B53B"/>
                    <SolidColorBrush x:Key="FailBg" Color="#3B1A1F"/>
                    <SolidColorBrush x:Key="FailText" Color="#FCA5A5"/>
                    <SolidColorBrush x:Key="FailStrong" Color="#F26B6B"/>
                    <SolidColorBrush x:Key="Overlay" Color="#CC05070C"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <LinearGradientBrush x:Key="BrandGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#6366F1" Offset="0"/>
                <GradientStop Color="#8B5CF6" Offset="0.55"/>
                <GradientStop Color="#EC4899" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BrandGradientHover" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#7477F4" Offset="0"/>
                <GradientStop Color="#9A6EF8" Offset="0.55"/>
                <GradientStop Color="#F062A8" Offset="1"/>
            </LinearGradientBrush>
            <Color x:Key="SystemAccentColor">#6366F1</Color>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <!-- Bouton principal en dégradé EFP -->
        <Style Selector="Button.primary">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{StaticResource BrandGradient}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandGradientHover}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <!-- Champs du menu : lecture seule = texte simple, double-clic pour modifier -->
        <Style Selector="TextBox.inline">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.inline[IsReadOnly=True]">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="TextBox.inline[IsReadOnly=True]:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource PillBg}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.inline[IsReadOnly=True]:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
    </Application.Styles>
</Application>
